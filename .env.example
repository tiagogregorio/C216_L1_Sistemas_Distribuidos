POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enade_platform

API_PORT=8000
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# Assistente de IA (Google Gemini) - opcional. Sem essa chave, o botao
# "Assistente IA" do quiz mostra uma mensagem de indisponivel, mas o resto
# da aplicacao funciona normalmente. Obtenha uma chave gratuita em
# https://aistudio.google.com/apikey e cole o valor real apenas no seu
# arquivo .env local (nunca no .env.example nem no Git).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
